        "id": "message",
        "title": "Process a message in a headless application",
        "description": "Adapt the supplied system test into a standalone program that registers a message, injects it, advances the app, and asserts the resulting score.",
        "code": "use bevy::prelude::*;\n\n#[derive(Message)]\nstruct EnemyDied(u32);\n\n#[derive(Resource)]\nstruct Score(u32);\n\nfn update_score(mut messages: MessageReader<EnemyDied>, mut score: ResMut<Score>) {\n    for message in messages.read() {\n        score.0 += message.0;\n    }\n}\n\nfn main() {\n    let mut app = App::new();\n    app.insert_resource(Score(0))\n        .add_message::<EnemyDied>()\n        .add_systems(Update, update_score);\n\n    app.world_mut()\n        .resource_mut::<Messages<EnemyDied>>()\n        .write(EnemyDied(3));\n\n    app.update();\n\n    assert_eq!(app.world().resource::<Score>().0, 3);\n}\n",
        "default_features": false,
        "features": [
